{
  "name": "oradiscuss-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && find dist -name '.DS_Store' -delete",
    "preview": "astro preview",
    "test": "node --test \"test/*.test.js\"",
    "astro": "astro",
    "build:showcase": "node scripts/showcase/build.mjs",
    "test:showcase-guards": "bash scripts/showcase/selftest-guards.sh",
    "build:brand": "node scripts/brand/build-logo.mjs && node scripts/brand/contact-sheet.mjs",
    "build:og": "node scripts/brand/build-og-card.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^6.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  }
}
