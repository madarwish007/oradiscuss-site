# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# Local Worker secrets for `wrangler dev`. A real BEEHIIV_API_KEY or
# TURNSTILE_SECRET reaching git is a rotation, not a mistake.
.dev.vars
.dev.vars.*

# wrangler build and dev scratch
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Generated knowledge graph (rebuild with: graphify update .)
graphify-out/

# Showcase capture scratch. Both are removed by scripts/showcase/build.mjs;
# they are listed here so a crashed run cannot leave the tree dirty.
.showcase-run/
.showcase-work/

# release artefacts (zips + generated SQL) from scripts/release-pack.sh
.release-out/
