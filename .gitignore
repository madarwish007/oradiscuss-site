# build output
dist/
# generated types
.astro/

# dependencies. Both forms on purpose: this worktree carries node_modules as a
# SYMLINK to a sibling checkout, and a trailing-slash pattern does not match a
# symlink, so `git add -A` committed it once.
node_modules/
# ...and as a bare name, because a trailing slash does NOT match a SYMLINK.
# Parallel work runs in git worktrees that symlink node_modules back to the
# main checkout, and `git add -A` will happily commit that symlink through a
# `node_modules/` rule. Caught once before it landed; this is the fix.
node_modules
node_modules

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# Local Worker secrets for `wrangler dev`. A real BEEHIIV_API_KEY or
# TURNSTILE_SECRET reaching git is a rotation, not a mistake.
.dev.vars
.dev.vars.*

# wrangler build and dev scratch
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Generated knowledge graph (rebuild with: graphify update .)
graphify-out/

# Showcase capture scratch. Both are removed by scripts/showcase/build.mjs;
# they are listed here so a crashed run cannot leave the tree dirty.
.showcase-run/
.showcase-work/

# release artefacts (zips + generated SQL) from scripts/release-pack.sh
.release-out/
