---
const path = Astro.url.pathname;
function isActive(prefix: string): boolean {
  if (prefix === '/') return path === '/' || path === '';
  const bare = prefix.replace(/\/$/, '');
  return path === bare || path === bare + '/' || path.startsWith(bare + '/');
}

type NavItem = { href: string; label: string };

/* The nav names what the site SELLS first, then what it publishes.
   It used to be the old blog's category list, and it was measurably wrong for
   this site: four of nine slots went to article categories, TWO of which hold
   exactly ONE article each (/scripts/ and /goldengate/), "Exadata" pointed at
   /oci/ so the label did not match its own URL, and the three pages that
   describe the product, /pricing/ /kit/ /roadmap/, appeared NOWHERE.

   Moving the categories out orphans nothing: /articles/ links every one of
   them and so does the footer, which is two doors rather than one.

   "Home" is gone as an item because the logo already goes there. Carrying both
   spends a nav slot on a link the visitor already has. */
const items: NavItem[] = [
  { href: '/pricing/', label: 'Membership' },
  { href: '/kit/', label: 'Free kit' },
  { href: '/articles/', label: 'Articles' },
  { href: '/tools/', label: 'Tools' },
  { href: '/roadmap/', label: 'Roadmap' },
  { href: '/about/', label: 'About' },
];
/* /services/ moves to the FOOTER rather than out of the site. It is the
   founder's consulting channel; removing it entirely is his decision and not
   a seat's, so it stays reachable and is only demoted. */
---
<header>
  <div class="HI">
    <a class="logo" href="/" aria-label="OraDiscuss home">
      <div class="lm">Od</div>
      <div class="ln">Ora<em>Discuss</em></div>
    </a>
    <nav id="MAIN-NAV">
      {items.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'act' : ''}>{item.label}</a>
      ))}
    </nav>
    <button class="nav-toggle" id="NAV-TOGGLE" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="HR">
      <div class="SIW">
        <span style="color:var(--ink-4);font-size:13px" aria-hidden="true">⌕</span>
        <input type="text" id="SI" placeholder="Search articles..." autocomplete="off" aria-label="Search articles" />
        <div class="SD" id="SD" role="listbox"></div>
      </div>
      <a
        href="https://ace.oracle.com/ords/ace/profile/madarwish"
        target="_blank"
        rel="noopener"
        class="ace-btn"
        title="Oracle ACE Associate · 2026"
      >
        <img src="/badge-ace-associate-2026-hx.png" alt="Oracle ACE Associate 2026" loading="lazy" />
        <span>ACE Associate</span>
        <span class="ace-year">2026</span>
      </a>
    </div>
  </div>
</header>
<div class="nav-backdrop" id="NAV-BACKDROP"></div>

<script is:inline>
  (function () {
    var toggle = document.getElementById('NAV-TOGGLE');
    var nav = document.getElementById('MAIN-NAV');
    var back = document.getElementById('NAV-BACKDROP');
    if (!toggle || !nav || !back) return;
    function open() {
      toggle.classList.add('open');
      nav.classList.add('open');
      back.classList.add('open');
      document.body.classList.add('nav-open');
      toggle.setAttribute('aria-expanded', 'true');
    }
    function close() {
      toggle.classList.remove('open');
      nav.classList.remove('open');
      back.classList.remove('open');
      document.body.classList.remove('nav-open');
      toggle.setAttribute('aria-expanded', 'false');
    }
    toggle.addEventListener('click', function () {
      if (toggle.classList.contains('open')) close();
      else open();
    });
    back.addEventListener('click', close);
    nav.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.tagName === 'A') close();
    });
  })();
</script>
