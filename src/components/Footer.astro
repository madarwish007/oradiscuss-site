---
const year = new Date().getFullYear();

/* The footer carries four columns and `.FI` declares exactly four, so a fifth
   wraps under the brand block. That is the constraint every change here works
   inside.

   The old "Resources" column was four EXTERNAL Oracle links (ACE programme, My
   Oracle Support, the 26ai docs, Ask TOM). It was replaced by the Membership
   column rather than kept, for two reasons: the footer previously linked NONE
   of what the site sells, and those four were generic bookmarks that send a
   visitor away. `/tools/` is our own on-site Oracle error lookup and docs
   search, so pointing at it is a straight upgrade on two of the four rather
   than a loss. If the founder wants the external list back it belongs on a
   page, not in the furniture. */
---
<footer>
  <div class="FI">
    <div class="FB">
      <a class="logo" href="/">
        <div class="lm">Od</div>
        <div class="ln">Ora<em>Discuss</em></div>
      </a>
      <p>
        Oracle DBA insights from a practising Oracle ACE Associate, covering performance
        engineering, RAC, Exadata, GoldenGate, and the hard problems that do not have Stack
        Overflow answers.
      </p>
    </div>
    <div class="FC">
      <h4>Membership</h4>
      <ul>
        <li><a href="/pricing/">Tiers and pricing</a></li>
        <li><a href="/kit/">Free DBA First Aid Kit</a></li>
        <li><a href="/roadmap/">Course roadmap</a></li>
        <li><a href="/tools/">Error lookup and search</a></li>
        <li><a href="/services/">Consulting</a></li>
      </ul>
    </div>
    <div class="FC">
      <h4>Writing</h4>
      <ul>
        <li><a href="/articles/">All articles</a></li>
        <li><a href="/dba/">Advanced DBA</a></li>
        <li><a href="/oci/">Exadata and OCI</a></li>
        <li><a href="/goldengate/">GoldenGate</a></li>
        <li><a href="/scripts/">Scripts Library</a></li>
        <li><a href="/asm/">ASM</a></li>
      </ul>
    </div>
    <div class="FC">
      <h4>Connect</h4>
      <ul>
        <li><a href="https://www.linkedin.com/in/darwishmahmoud/" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="https://community.oracle.com/" target="_blank" rel="noopener">Oracle Community</a></li>
        <li><a href="https://github.com/MaDarwish" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="/rss.xml">RSS Feed</a></li>
        <li><a href="/about/">About Me</a></li>
      </ul>
    </div>
  </div>
  <div class="FB2">
    <span>© {year} OraDiscuss · Mahmoud Darwish · Oracle ACE Associate</span>
    <nav class="FLg" aria-label="Legal">
      <a href="/terms/">Terms</a>
      <a href="/privacy/">Privacy</a>
      <a href="/refund/">Refunds</a>
      <a href="/contact/">Contact</a>
    </nav>
    <span>oradiscuss.com</span>
  </div>
</footer>

<style>
  /* Legal links live in the bottom bar rather than as a fifth footer column:
     .FI declares exactly four grid columns, so a fifth child would wrap under
     the brand block. Inherits the bar's type so nothing new is introduced. */
  .FLg {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .FLg a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }
  .FLg a:hover {
    color: var(--act);
  }
</style>
