---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  canonical?: string | URL;
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = 'OraDiscuss: Oracle Mastery, Distilled',
  description = 'Production-grade Oracle DBA insights from a practising Oracle ACE Associate. Exadata, RAC, AWR, GoldenGate, OCI: the hard problems, solved in writing.',
  image = '/og-card.png',
  article = false,
  canonical,
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? 'https://oradiscuss.com';
const canonicalURL = canonical
  ? new URL(canonical, siteOrigin).href
  : new URL(Astro.url.pathname, siteOrigin).href;
const imageURL = new URL(image, siteOrigin).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Mahmoud Darwish" />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content="OraDiscuss" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:url" content={canonicalURL} />
<meta property="article:author" content="Mahmoud Darwish" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- The tab icon is the TWO ARC file. A favicon is never drawn larger than
     about 24px and the three arc form greys out below that, so /logo.svg is
     deliberately not used here. mask-icon is Safari's monochrome pinned tab,
     so it takes the mark's ink rather than an accent. theme-color paints the
     mobile browser chrome and is matched to the header ground it sits against.
     Both attributes carried the dropped Oracle red until Phase 2b. -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="mask-icon" href="/favicon.svg" color="#1C1917" />
<meta name="theme-color" content="#F7F5F1" />
<meta name="google-site-verification" content="mQYy7TOgJ0hwpmQH37WEmgHRsuEWktzpNxDRKpUAkKk" />

<link rel="alternate" type="application/rss+xml" title="OraDiscuss RSS" href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Instrument type: Sora display, Archivo body, JetBrains Mono for data. -->
<link
  href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@600;700;800&display=swap"
  rel="stylesheet"
/>

<meta name="generator" content={Astro.generator} />

<script is:inline>
  (function () {
    /* The reveal is opt IN. Content is visible by default and this class is
       what allows anything to be hidden, so a JS failure can never blank a
       page. It runs in the head, before first paint, to avoid a flash. */
    try {
      var reduce =
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        window.matchMedia('(max-width: 767px)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        document.documentElement.className += ' motion';
      }
    } catch (e) {
      /* no motion class, everything stays visible */
    }
  })();
</script>

<script is:inline>
  (function () {
    var h = location.hostname;
    var isCanonical = h === 'oradiscuss.com' || h === 'www.oradiscuss.com';
    /* Sanctioned non-production origins: local dev and any Workers preview
       environment. These must stay reachable. */
    var isDevOrPreview =
      h === 'localhost' || h === '127.0.0.1' || /\.workers\.dev$/.test(h);

    /* Any host that is not the canonical domain stays out of search results,
       preview environments included. */
    if (!isCanonical) {
      var m = document.createElement('meta');
      m.name = 'robots';
      m.content = 'noindex, nofollow';
      document.head.appendChild(m);
    }

    /* Only bounce hosts that are neither canonical nor a sanctioned preview
       origin. That preserves the original intent (stop mirrors and stray
       hostnames competing with the canonical domain) without sending the
       preview environment to production, which silently turned every preview
       check into a test of production. */
    if (!isCanonical && !isDevOrPreview) {
      location.replace(
        'https://oradiscuss.com' + location.pathname + location.search + location.hash
      );
    }
  })();
</script>
<script src="/search.js" defer></script>
</head>
<body>
<div id="SB"></div>

<Header />

<main>
  <slot />
</main>

<Footer />

<script is:inline>
  // Scroll progress bar
  (function () {
    var bar = document.getElementById('SB');
    if (!bar) return;
    var ticking = false;
    function update() {
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      var pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
      bar.style.width = pct + '%';
      ticking = false;
    }
    window.addEventListener(
      'scroll',
      function () {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    update();
  })();

  /* Reveal on scroll, plus the counters that dramatize a report filling in.
     One contract for the whole site: .rv is revealed by .vis, and the
     numbers settle on their final value whatever happens. */
  (function () {
    var els = document.querySelectorAll('.rv');
    var counters = document.querySelectorAll('[data-count-to]');

    function settleCounter(el) {
      el.textContent = el.getAttribute('data-count-to') || '0';
    }
    function settleAll() {
      els.forEach(function (el) { el.classList.add('vis'); });
      counters.forEach(settleCounter);
    }

    if (!document.documentElement.classList.contains('motion')) {
      settleAll();
      return;
    }

    function runCount(el) {
      var to = parseInt(el.getAttribute('data-count-to'), 10);
      if (!to) { settleCounter(el); return; }
      var start = null;
      var dur = 900;
      function step(ts) {
        if (start === null) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        /* ease out expo, so it settles rather than ticks */
        var eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
        el.textContent = String(Math.round(to * eased));
        if (p < 1) requestAnimationFrame(step);
      }
      setTimeout(function () { requestAnimationFrame(step); }, 560);
    }

    function reveal(el) {
      if (el.classList.contains('vis')) return;
      el.classList.add('vis');
      var inner = el.querySelectorAll ? el.querySelectorAll('[data-count-to]') : [];
      inner.forEach(runCount);
    }
    function revealAll() { els.forEach(reveal); }

    var delivered = false;
    var io = null;
    if ('IntersectionObserver' in window) {
      io = new IntersectionObserver(
        function (entries) {
          delivered = true;
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            reveal(e.target);
            io.unobserve(e.target);
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
      );
      els.forEach(function (el) { io.observe(el); });
    }

    /* Anything on or near the first screen is revealed without waiting for a
       callback, so the top of the page never depends on async work. One turn
       of the event loop first, so the entrance still animates. */
    setTimeout(function () {
      var h = window.innerHeight || 800;
      els.forEach(function (el) {
        if (el.getBoundingClientRect().top < h * 1.05) reveal(el);
      });
    }, 0);

    /* Backstop. A throttled or undelivered observer must never be able to
       leave content hidden, so if nothing has been delivered by now, show
       everything. setTimeout still fires where rAF and IntersectionObserver
       are throttled, which is exactly the case this guards. */
    setTimeout(function () { if (!delivered) revealAll(); }, 1200);

    /* A counter that sits outside any .rv still has to run. */
    counters.forEach(function (c) {
      if (!c.closest('.rv')) runCount(c);
    });
  })();
</script>

<script is:inline>
  (function () {
    var h = location.hostname;
    if (h === 'oradiscuss.com' || h === 'www.oradiscuss.com') {
      var s = document.createElement('script');
      s.defer = true;
      s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      s.setAttribute(
        'data-cf-beacon',
        '{"token":"74c0753c3129495abc5257ec1e3a48b6"}'
      );
      document.head.appendChild(s);
    }
  })();
</script>
</body>
</html>
