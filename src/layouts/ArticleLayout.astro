---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Comments from '../components/Comments.astro';
import MorePosts from '../components/MorePosts.astro';
import Newsletter from '../components/Newsletter.astro';
import { CATEGORY_LABEL } from '../content.config';
import { tagLabel, tagSlug } from '../lib/tagLabel';
import readingTime from 'reading-time';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data, id } = post;
const bodyStr = (post as unknown as { body?: string }).body ?? '';

const categoryLabel = CATEGORY_LABEL[data.category];
const siteOrigin = Astro.site?.origin ?? 'https://oradiscuss.com';
const articleUrl = new URL(Astro.url.pathname, siteOrigin).href;
const slugPath = `/${data.category}/${id}`;

const rt = readingTime(bodyStr);
const minutes = Math.max(1, Math.round(rt.minutes));
const readLabel = `${minutes} min read`;

const dateLabel = data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const ogImage = data.cover ?? '/og-image.png';

const tags = (data.tags ?? [])
  .map((t) => tagSlug(t))
  .filter((s) => s.length > 0);
---
<BaseLayout
  title={`${data.title} · OraDiscuss`}
  description={data.description}
  article={true}
  image={ogImage}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate ?? data.pubDate}
>
  <section class="art-hero">
    <div class="art-container">
      <a class="art-back" href="/">← All Articles</a>
      <div class={`art-cat ${data.category}`}>{categoryLabel}</div>
      <h1 class="art-title">{data.title}</h1>
      <div class="art-meta">
        <span>Mahmoud Darwish</span><span class="sep">·</span>
        <span>{dateLabel}</span><span class="sep">·</span>
        <span>{readLabel}</span>
      </div>
    </div>
  </section>

  {data.cover && (
    <div class="art-cover">
      <img src={data.cover} alt={data.coverAlt || data.title} loading="eager" decoding="async" />
    </div>
  )}

  <section class="art-body-wrap">
    <article class="art-prose">
      <slot />
    </article>
    {tags.length > 0 && (
      <div class="art-tags">
        <span class="art-tags-label">Tags</span>
        <ul class="art-tags-list">
          {tags.map((t) => (
            <li>
              <a href={`/tags/${t}/`}>{tagLabel(t)}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <ShareButtons title={data.title} url={articleUrl} />
    <Comments slug={slugPath} />
  </section>

  <style>
    .art-tags {
      max-width: 820px;
      margin: 36px auto 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }
    .art-tags-label {
      font-family: var(--jb);
      font-size: 10.5px;
      font-weight: 600;
      color: var(--ink3);
      text-transform: uppercase;
      letter-spacing: 0.13em;
    }
    .art-tags-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .art-tags-list a {
      display: inline-block;
      padding: 7px 13px;
      border: 1px solid var(--hair);
      border-radius: var(--r-pill);
      font-family: var(--jb);
      font-size: 10.5px;
      font-weight: 500;
      letter-spacing: 0.06em;
      color: var(--ink3);
      text-decoration: none;
      background: var(--surface);
      transition: color 150ms ease, border-color 150ms ease;
    }
    .art-tags-list a:hover {
      color: var(--act);
      border-color: var(--act);
    }
  </style>

  <MorePosts currentId={id} />
  <Newsletter />
</BaseLayout>
