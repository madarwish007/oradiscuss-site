---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { tagLabel } from '../../lib/tagLabel';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const seen = new Set<string>();
  for (const post of all) {
    for (const t of post.data.tags) {
      const slug = t.trim().toLowerCase();
      if (slug) seen.add(slug);
    }
  }
  return Array.from(seen).map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const tagSlug = (tag ?? '').toLowerCase();
const label = tagLabel(tagSlug);

const posts = (
  await getCollection(
    'blog',
    ({ data }) =>
      !data.draft && data.tags.some((t) => t.trim().toLowerCase() === tagSlug)
  )
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function sizeFor(i: number): 'PCF' | 'PCT' | 'PCW' | 'PCN' {
  if (i === 0) return 'PCF';
  if (i < 3) return 'PCT';
  if (i < 5) return 'PCW';
  return 'PCN';
}
---
<BaseLayout
  title={`${label} — OraDiscuss`}
  description={`OraDiscuss articles tagged ${label}: ${posts.length} post${posts.length === 1 ? '' : 's'} on Oracle DBA, OCI, and related topics.`}
>
  <section class="art-hero">
    <div class="art-container">
      <a class="art-back" href="/">← All Articles</a>
      <div class="art-cat">Tag</div>
      <h1 class="art-title">{label}</h1>
      <p style="color:var(--ink-3);font-size:17px;line-height:1.65;max-width:700px;margin-top:12px">
        Every OraDiscuss article tagged <strong>{label}</strong>, newest first.
      </p>
      <div class="art-meta" style="margin-top:16px">
        <span>
          {posts.length} article{posts.length === 1 ? '' : 's'}
          {posts[0] && (
            <>
              {' · updated '}
              {posts[0].data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </>
          )}
        </span>
      </div>
    </div>
  </section>

  <section id="posts">
    <div class="SW2">
      <div class="BG rv">
        {posts.length === 0 && (
          <div
            style="grid-column:1/-1;padding:40px;background:#fff;border:1px solid var(--border);border-radius:var(--r-md);text-align:center;color:var(--ink-3)"
          >
            <p>No articles tagged <strong>{label}</strong> yet.</p>
          </div>
        )}
        {posts.map((p, i) => <PostCard post={p} size={sizeFor(i)} />)}
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
