---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanGrid from '../components/PlanGrid.jsx';

/* Three sections, in this order and no more: the hero (which carries its own
   proof), the membership (what you get and what it costs, as one decision),
   and one path onward. Everything a sceptical, time poor DBA needs to judge
   this, and nothing that only restates it. */

const packs = [
  {
    n: '01',
    name: 'Health Check',
    tag: 'Free',
    collects:
      'Instance, tablespaces, invalid objects, jobs, ADR scan, archivelog and FRA, ASM, RMAN recency.',
  },
  {
    n: '02',
    name: 'RCA Generator',
    tag: 'Toolkit',
    collects:
      'Grid Infrastructure logs, OS messages, ADR incidents, the alert log, the AWR window.',
  },
  {
    n: '03',
    name: 'Audit and Governance',
    tag: 'Toolkit',
    collects:
      'Access review across every container, privilege drift since last quarter, dormant accounts, privileged session extract.',
  },
  {
    n: '04',
    name: 'Daily-Ops',
    tag: 'Toolkit',
    collects:
      'Growth trends, top segments, RMAN and standby gap, stale statistics, failed logins, invalid-object deltas.',
  },
];
---
<BaseLayout
  title="OraDiscuss: read-only Oracle tooling that feeds your own AI"
  description="Read-only Oracle DBA packs that run on your machine and produce two things from one collection: a report you read, and a briefing your own AI reads. Nothing is uploaded."
>
<div class="inst">

  <!-- ===================== 1. HERO, WITH THE PROOF ===================== -->
  <section class="inst-hero-wrap">
    <div class="inst-aurora" aria-hidden="true"><span></span></div>
    <div class="inst-grid-rule" aria-hidden="true"></div>

    <div class="i-shell inst-hero">
      <div class="inst-hero-copy">
        <p class="i-eyebrow rv" style="--d:0ms">Oracle 19c to 26ai · read-only</p>
        <h1>
          <span class="inst-h1line rv" style="--d:70ms">Your scripts collect.</span>
          <span class="inst-h1line rv inst-accent" style="--d:140ms">Your AI reasons.</span>
          <span class="inst-h1line rv" style="--d:210ms">Your data never leaves.</span>
        </h1>
        <p class="inst-lede rv" style="--d:300ms">
          Every pack runs on your own machine, reads only, and produces two things from one
          collection: a report you read, and a briefing your own AI reads. Nothing is uploaded.
        </p>
        <div class="inst-actions rv" style="--d:370ms">
          <a class="i-btn i-btn-primary" href="/kit/">Get the free kit</a>
          <a class="i-btn i-btn-ghost" href="#artifact">See a real report</a>
        </div>
        <div class="i-meta rv" style="--d:440ms">
          <span>Author<b>Mahmoud Darwish</b></span>
          <span>Coverage<b>Oracle 9i to 26ai</b></span>
          <span>Estates<b>Exadata, RAC, OCI</b></span>
        </div>
      </div>

      <aside
        class="inst-artifact rv"
        style="--d:520ms"
        id="artifact"
        aria-label="Example health check report"
      >
        <header>
          <span>health_check v1.0</span>
          <span class="inst-live"><i></i>read-only</span>
        </header>
        <h2>Morning report</h2>
        <dl>
          <div class="inst-row" style="--r:0">
            <dt>Tablespaces checked</dt>
            <dd class="inst-ok"><span data-count-to="42">42</span> / 42</dd>
          </div>
          <div class="inst-row" style="--r:1"><dt>Archivelog and FRA</dt><dd class="inst-ok">Clear</dd></div>
          <div class="inst-row" style="--r:2"><dt>RMAN recency</dt><dd class="inst-ok">6h ago</dd></div>
          <div class="inst-row" style="--r:3"><dt>Standby gap</dt><dd class="inst-ok">0 blocks</dd></div>
          <div class="inst-row" style="--r:4"><dt>Invalid objects</dt><dd class="inst-ok">None new</dd></div>
        </dl>
        <div class="inst-dual">
          <div><b>report.html</b><span>you read this</span></div>
          <div><b>briefing.json</b><span>your AI reads this</span></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ 2. MEMBERSHIP: WHAT YOU GET AND WHAT IT COSTS ============ -->
  <section class="inst-band" id="membership">
    <div class="i-shell">
      <p class="i-eyebrow i-eyebrow-deep rv">Membership</p>
      <h2 class="rv">Four packs, one annual membership.</h2>

      <ol class="inst-packs">
        {packs.map((p, i) => (
          <li class="inst-pack rv" style={`--d:${i * 60}ms`}>
            <span class="inst-pack-n">{p.n}</span>
            <span class="inst-pack-name">
              {p.name}
              <span class={`inst-chip${p.tag === 'Free' ? ' inst-chip-free' : ''}`}>{p.tag}</span>
            </span>
            <span class="inst-pack-what">{p.collects}</span>
          </li>
        ))}
      </ol>

      <div class="inst-plans rv">
        <PlanGrid client:load />
      </div>
    </div>
  </section>

  <!-- ==================== 3. ONE PATH ONWARD ==================== -->
  <section class="i-shell inst-close">
    <p class="inst-trust rv">
      Every script here ran on real production estates by a working DBA before it was published.
    </p>
    <a class="inst-onward rv" href="/articles/">Read the field notes</a>
  </section>

</div>

<style is:global>
/* ================= INSTRUMENT, HOME PAGE COMPOSITION =================
   The system itself (tokens, type, buttons, eyebrow, cards, mono labels,
   focus, the reveal contract) lives in src/styles/global.css and is shared
   by every page. What stays here is only what this page composes: the
   aurora, the artifact panel, the navy band. See DESIGN.md.
   ==================================================================== */
.inst{background:var(--field);color:var(--ink2)}
.inst h2{
  margin-top:16px;font-family:var(--sora);font-size:clamp(1.65rem,3.1vw,2.5rem);font-weight:700;
  line-height:1.14;letter-spacing:-.03em;color:var(--ink);max-width:22ch;text-wrap:balance
}

/* ---- hero ---- */
.inst-hero-wrap{position:relative;overflow:clip;padding-bottom:24px}
.inst-aurora{position:absolute;inset:-30% -12% auto -12%;height:1120px;pointer-events:none;z-index:0}
.inst-aurora span{display:block;width:100%;height:100%;filter:blur(46px);
  background:
    radial-gradient(40% 48% at 16% 24%,rgba(31,90,168,.42),transparent 68%),
    radial-gradient(36% 42% at 76% 14%,rgba(31,163,122,.36),transparent 70%),
    radial-gradient(34% 40% at 54% 58%,rgba(199,70,52,.30),transparent 72%);
  animation:inst-drift 28s ease-in-out infinite alternate}
@keyframes inst-drift{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(-3%,2%,0) scale(1.08)}}
.inst-grid-rule{position:absolute;inset:0;z-index:0;pointer-events:none;
  background-image:linear-gradient(90deg,rgba(11,27,52,.045) 1px,transparent 1px);
  background-size:112px 100%;
  -webkit-mask-image:linear-gradient(180deg,#000,transparent 72%);
  mask-image:linear-gradient(180deg,#000,transparent 72%)}
.inst-hero{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) 372px;
  gap:56px;align-items:start;padding-top:clamp(104px,9vw,146px);padding-bottom:clamp(64px,7vw,104px)}
.inst-hero-copy{min-width:0}
/* The scale is bound by the longest authored line, "Your data never leaves.",
   measured at 10.96em wide in Sora 800. Every step below keeps that line
   inside the copy column, because a sentence breaking across two lines is a
   defect in this system, not a reflow.

   Two regimes, because the hero has two layouts and the copy column changes
   width discontinuously between them, so no single vw slope can serve both:
     above 1080  two columns, copy is 609px at 1081 and 700px at 1440.
                 5vw is the steepest slope that keeps the line whole at 1081,
                 the tightest point on the curve; the 3.9rem cap holds above.
     1080 down   one column, copy is 968px at 1080 falling to 272px at 320.
                 7.3vw fits the line at every step down to a 320px phone.
   The cap in the narrow regime is 3.375rem = 54px, which is exactly the wide
   regime's value at 1081px (5vw x 1081 = 54.05px). That is what makes the
   scale MONOTONIC: crossing the breakpoint downward can only hold the size
   or lower it, never raise it. It also fixes the ceiling of the 961 to 1079
   band. That band still runs slack against its measure, and it has to: any
   larger there would be larger than the two-column layout can carry one step
   wider, which is the discontinuity this replaced. */
.inst h1{margin-top:20px;font-family:var(--sora);font-size:clamp(2.35rem,5vw,3.9rem);font-weight:800;
  line-height:1.05;letter-spacing:-.038em;color:var(--ink)}
/* Each sentence owns its own line. Never left to the browser. */
.inst-h1line{display:block;font-size:inherit;font-family:inherit;line-height:inherit}
.inst-accent{color:var(--blue)}
.inst-lede{margin-top:24px;max-width:58ch;font-size:clamp(16.5px,1.25vw,18.5px);color:var(--ink2)}
.inst-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}
.inst-hero .i-meta{margin-top:52px}

/* The single glass surface in the system: the product's real artifact. */
.inst-artifact{background:rgba(255,255,255,.62);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border:1px solid rgba(255,255,255,.9);border-radius:var(--r-panel);padding:22px;min-width:0;
  box-shadow:0 26px 70px rgba(11,27,52,.16)}
.inst-artifact header{display:flex;justify-content:space-between;align-items:center;gap:12px;
  font-family:var(--jb);font-size:10.5px;font-weight:600;letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink3)}
.inst-live{color:var(--ok-text);display:inline-flex;align-items:center;gap:6px}
.inst-live i{width:7px;height:7px;border-radius:50%;background:var(--ok);animation:inst-pulse 2.4s ease-in-out infinite}
@keyframes inst-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.82)}}
.inst-artifact h2{margin-top:14px;max-width:none;font-size:16px;font-weight:700;letter-spacing:-.025em}
.inst-artifact dl{margin-top:6px}
.inst-row{display:flex;justify-content:space-between;gap:14px;padding:9px 0;
  border-bottom:1px solid rgba(11,27,52,.07);font-size:13.2px;color:var(--ink2)}
.inst-row:last-of-type{border-bottom:0}
.inst-row dd{font-weight:600}
.inst-ok{color:var(--ok-text)}
.inst-dual{margin-top:15px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.inst-dual div{border:1px solid rgba(11,27,52,.1);border-radius:8px;padding:9px 10px;
  background:rgba(255,255,255,.6);min-width:0}
.inst-dual b{display:block;font-family:var(--jb);font-size:10.5px;font-weight:600;color:var(--ink)}
.inst-dual span{display:block;margin-top:3px;font-family:var(--jb);font-size:9.5px;font-weight:400;color:var(--ink3)}

/* ---- the navy band: the structural signature of the system ---- */
.inst-band{position:relative;margin-top:10px;
  padding:clamp(104px,11vw,140px) 0 clamp(80px,9vw,110px);
  background:linear-gradient(158deg,#0B1B34 0%,#0E2A52 54%,#0B4A6F 100%);
  clip-path:polygon(0 5%,100% 0,100% 100%,0 100%)}
.inst-band h2{color:#fff}

/* The four packs as a ledger, not as cards. One line each. */
.inst-packs{margin-top:38px;list-style:none;padding:0;border-top:1px solid rgba(159,182,212,.22)}
.inst-pack{display:grid;grid-template-columns:44px 220px minmax(0,1fr);gap:20px;align-items:baseline;
  padding:16px 0;border-bottom:1px solid rgba(159,182,212,.22)}
/* The index takes --on-deep, the same as the description beside it. On a dark
   ground "quieter" means closer to the ground, and there is no step below
   --on-deep that still clears 4.5:1 anywhere in the band; the bespoke #6E8BB3
   that used to sit here measured 4.38. The mono face, 11px size and .1em
   tracking carry the hierarchy instead of tone. */
.inst-pack-n{font-family:var(--jb);font-size:11px;font-weight:600;letter-spacing:.1em;color:var(--on-deep)}
.inst-pack-name{display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  font-family:var(--sora);font-size:16px;font-weight:700;letter-spacing:-.025em;color:#fff}
.inst-pack-what{font-size:14px;line-height:1.6;color:var(--on-deep)}
.inst-chip{font-family:var(--jb);font-size:9.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
  border:1px solid rgba(159,182,212,.4);border-radius:999px;padding:3px 9px;color:var(--on-deep)}
.inst-chip-free{color:#7FD3B4;border-color:rgba(127,211,180,.45)}

.inst-plans{margin-top:52px}
.inst .plans{display:grid;grid-template-columns:repeat(auto-fit,minmax(262px,1fr));gap:18px;
  list-style:none;padding:0;margin:0}
/* The <li> is the grid cell and the <article> fills it, so the list markup
   costs the layout nothing. */
.inst .plans>li{display:flex;min-width:0}
.inst .plans>li>.plan{flex:1}
.inst .plan{background:var(--surface);border:1px solid var(--hair);border-radius:var(--r-card);padding:26px;min-width:0;
  box-shadow:0 16px 40px rgba(3,12,26,.28);display:flex;flex-direction:column;gap:2px;
  transition:transform .22s var(--ease),box-shadow .22s}
.inst .plan:hover{transform:translateY(-3px);box-shadow:0 22px 52px rgba(3,12,26,.34)}
.inst .plan.is-pick{border:1.5px solid var(--act)}
.inst .plan-k{font-family:var(--jb);font-size:10.5px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-4)}
.inst .plan.is-pick .plan-k{color:var(--act)}
.inst .plan h3{margin-top:11px;font-family:var(--sora);font-size:17.5px;font-weight:700;letter-spacing:-.025em;color:var(--ink)}
.inst .plan-price{margin-top:13px;font-family:var(--sora);font-size:34px;font-weight:800;color:var(--ink);letter-spacing:-.03em}
.inst .plan-price small{font-family:var(--jb);font-size:13px;font-weight:500;color:var(--ink-4);letter-spacing:0}
.inst .plan-then{margin-top:5px;font-family:var(--jb);font-size:12.5px;font-weight:500;color:var(--ink-4)}
.inst .plan-lock{margin-top:9px;font-family:var(--jb);font-size:11.5px;font-weight:600;color:var(--ok-text)}
.inst .plan-blurb{margin-top:13px;font-size:14px;line-height:1.6;color:var(--ink2);flex:1}
/* .plan-cta was removed with the inert call to action it styled. It shipped
   in the bundle with zero matching elements. Phase 6 brings back a real one. */
.inst .plan-rules{margin-top:28px;padding-left:18px;display:flex;flex-direction:column;gap:7px;
  font-size:13.5px;line-height:1.6;color:var(--on-deep);max-width:74ch}
.inst .plans-note{margin-top:30px;font-family:var(--jb);font-size:13.5px;color:var(--on-deep)}

/* ---- the close: one path onward ---- */
.inst-close{padding:clamp(72px,9vw,112px) var(--gutter);display:flex;align-items:flex-end;
  justify-content:space-between;gap:32px;flex-wrap:wrap}
.inst-trust{max-width:32ch;font-family:var(--sora);font-size:clamp(1.25rem,2.2vw,1.7rem);font-weight:700;
  line-height:1.24;letter-spacing:-.03em;color:var(--ink)}
.inst-onward{display:inline-flex;align-items:center;gap:8px;font-family:var(--jb);font-size:11px;
  font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--act);text-decoration:none;
  padding-bottom:6px;border-bottom:1px solid var(--red-faint-2);transition:border-color .18s,gap .18s}
.inst-onward:hover{border-color:var(--act);gap:14px}
.inst-onward::after{content:'→'}

/* ---- responsive ---- */
/* Between 1080 and 1360 the artifact gives width back to the copy column so
   the headline keeps one sentence per line. */
@media(max-width:1360px){
  .inst-hero{grid-template-columns:minmax(0,1fr) 320px;gap:40px}
}
/* The hero collapses to one column here, so the headline switches to the
   single-column regime in the SAME query. The old page did this at 960
   instead, on the false premise that the measure narrows there; it widens
   (849px at 961 against 911px at 959), and the mismatch made the headline
   jump from 44.2px to 54.4px as the viewport got smaller. */
@media(max-width:1080px){
  .inst-hero{grid-template-columns:minmax(0,1fr);gap:44px}
  .inst-artifact{max-width:420px}
  .inst-pack{grid-template-columns:36px 190px minmax(0,1fr);gap:16px}
  .inst h1{font-size:clamp(1.4rem,7.3vw,3.375rem)}
}
@media(max-width:820px){
  .inst-pack{grid-template-columns:minmax(0,1fr);gap:6px;padding:18px 0}
  .inst-hero .i-meta{gap:22px 28px;margin-top:40px}
}
/* The mobile contract. The shared override in global.css already returns
   .rv to its final state; these are the page's own animations. */
@media(prefers-reduced-motion:reduce),(max-width:767px){
  .inst-aurora span{animation:none}
  .inst-live i{animation:none}
  .inst .plan:hover{transform:none}
  .inst-band{clip-path:polygon(0 2%,100% 0,100% 100%,0 100%)}
}
</style>
</BaseLayout>
