---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanGrid from '../components/PlanGrid.jsx';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const packs = [
  {
    n: '01',
    name: 'Health Check',
    tag: 'Free',
    what: 'Instance, tablespaces, invalid objects, jobs, ADR scan, archivelog and FRA, ASM, RMAN recency.',
    replaces: 'The half hour you spend every morning opening the same eight queries.',
  },
  {
    n: '02',
    name: 'RCA Generator',
    tag: 'Toolkit',
    what: 'Collects locally, root-capable: Grid Infrastructure logs, OS messages, ADR incidents, the alert log, and the AWR window.',
    replaces: 'The afternoon after an incident, spent reconstructing a timeline from six terminals.',
  },
  {
    n: '03',
    name: 'Audit and Governance',
    tag: 'Toolkit',
    what: 'Access review across every container, privilege drift since last quarter, dormant accounts, privileged session extract.',
    replaces: 'The quarterly user review that runs for hours across twenty pluggable databases.',
  },
  {
    n: '04',
    name: 'Daily-Ops',
    tag: 'Toolkit',
    what: 'Morning briefing: growth trends, top segments, RMAN and standby gap, stale statistics, failed logins, invalid-object deltas.',
    replaces: 'Reading four dashboards before your first coffee to learn nothing changed.',
  },
];
---
<BaseLayout
  title="OraDiscuss - read-only Oracle tooling that feeds your own AI"
  description="Read-only Oracle DBA packs that run on your machine and produce two things from one collection: a report you read, and a briefing your own AI reads. Nothing is uploaded."
  noindex={true}
>
<div class="inst">

  <!-- ============================ HERO ============================ -->
  <section class="hero-wrap">
    <div class="aurora" aria-hidden="true"><span></span></div>
    <div class="rule-grid" aria-hidden="true"></div>

    <div class="shell hero">
      <div class="hero-copy">
        <p class="eyebrow rv" style="--d:0ms">Oracle 19c to 26ai · read-only</p>
        <h1>
          <span class="h1line rv" style="--d:70ms">Your scripts collect.</span>
          <span class="h1line rv accent" style="--d:140ms">Your AI reasons.</span>
          <span class="h1line rv" style="--d:210ms">Your data never leaves.</span>
        </h1>
        <p class="lede rv" style="--d:300ms">
          Every pack runs on your own machine, reads only, and produces two things from one
          collection: a report you read, and a briefing your own AI reads. Nothing is uploaded.
          We never see your data.
        </p>
        <div class="actions rv" style="--d:370ms">
          <a class="btn btn-primary" href="#plans">Get the free kit</a>
          <a class="btn btn-ghost" href="#artifact">See a real report</a>
        </div>
        <div class="meta rv" style="--d:440ms">
          <span>Author<b>Mahmoud Darwish</b></span>
          <span>Coverage<b>Oracle 9i to 26ai</b></span>
          <span>Estates<b>Exadata, RAC, OCI</b></span>
          <span>Updates<b>Weekly and quarterly</b></span>
        </div>
      </div>

      <aside class="artifact rv" style="--d:520ms" id="artifact" aria-label="Example health check report">
        <header>
          <span class="mono">health_check v1.0</span>
          <span class="live"><i></i>read-only</span>
        </header>
        <h4>Morning report</h4>
        <dl>
          <div class="row" style="--r:0"><dt>Tablespaces checked</dt><dd class="ok"><span class="count" data-to="42">0</span> / 42</dd></div>
          <div class="row" style="--r:1"><dt>Archivelog and FRA</dt><dd class="ok">Clear</dd></div>
          <div class="row" style="--r:2"><dt>RMAN recency</dt><dd class="ok">6h ago</dd></div>
          <div class="row" style="--r:3"><dt>Standby gap</dt><dd class="ok">0 blocks</dd></div>
          <div class="row" style="--r:4"><dt>Invalid objects</dt><dd class="ok">None new</dd></div>
        </dl>
        <div class="dual">
          <div><b>report.html</b><span>you read this</span></div>
          <div><b>briefing.json</b><span>your AI reads this</span></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ======================= THE DUAL OUTPUT ======================= -->
  <section class="shell block">
    <p class="eyebrow rv">One run, two readers</p>
    <h2 class="rv">A chatbot cannot reach into your database. That is the whole gap.</h2>
    <div class="split">
      <div class="rv" style="--d:80ms">
        <h3>For the DBA who reads</h3>
        <p>
          A self-contained HTML report: evidence, a reconstructed timeline, and a ranked
          probable-cause chain with citations. It states what your database recorded. It never
          states a verdict and never issues a command, because that boundary is what keeps this
          safe to run.
        </p>
      </div>
      <div class="rv" style="--d:160ms">
        <h3>For the DBA who delegates</h3>
        <p>
          The same run writes <code>briefing.json</code> plus a prompt pack, shaped for a model
          rather than a person. You feed it to whichever AI you already pay for. Your AI, your
          subscription, your data, inside your own walls.
        </p>
      </div>
    </div>
  </section>

  <!-- =========================== THE PACKS =========================== -->
  <section class="shell block">
    <p class="eyebrow rv">What you actually get</p>
    <h2 class="rv">Four packs. Each one replaces a job you already do by hand.</h2>
    <ol class="packs">
      {packs.map((p, i) => (
        <li class="pack rv" style={`--d:${i * 70}ms`}>
          <span class="pack-n mono">{p.n}</span>
          <div class="pack-body">
            <h3>{p.name} <span class={`chip${p.tag === 'Free' ? ' chip-free' : ''}`}>{p.tag}</span></h3>
            <p>{p.what}</p>
            <p class="replaces"><span class="mono">replaces</span> {p.replaces}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============================ PLANS ============================ -->
  <section class="band" id="plans">
    <div class="shell">
      <p class="eyebrow eyebrow-on-dark rv">Membership</p>
      <h2 class="rv">Priced while the member count is small.</h2>
      <p class="band-lede rv">
        Annual. Your launch price is locked for life while you stay subscribed, and the regular
        price is shown beside it from day one. No countdowns, because the rise is announced in
        advance rather than manufactured.
      </p>
      <PlanGrid client:load />
    </div>
  </section>

  <!-- =========================== THE TRUST =========================== -->
  <section class="shell block">
    <p class="eyebrow rv">Before you run anything</p>
    <h2 class="rv">Four things that are true of every pack.</h2>
    <div class="truths">
      <div class="truth rv" style="--d:0ms">
        <h3>Read-only</h3>
        <p>No DDL, no DML, no change to your estate. Printed in the header of every file, and the source is yours to read before you run it.</p>
      </div>
      <div class="truth rv" style="--d:70ms">
        <h3>It runs where you are</h3>
        <p>On your machine, against your estate. Nothing is uploaded, so there is no service to review and no data of yours for us to lose.</p>
      </div>
      <div class="truth rv" style="--d:140ms">
        <h3>Evidence, not verdicts</h3>
        <p>The report shows what your database recorded and ranks probable causes with citations. It will not tell you what to do, and that is deliberate.</p>
      </div>
      <div class="truth rv" style="--d:210ms">
        <h3>Field-tested first</h3>
        <p>Every script ran on real production estates by a working DBA before it was published. Nothing ships from a lab alone.</p>
      </div>
    </div>
  </section>

  <!-- ========================== THE WRITING ========================== -->
  <section class="shell block">
    <div class="block-head">
      <div>
        <p class="eyebrow rv">The writing stays</p>
        <h2 class="rv">Field notes from real incidents.</h2>
      </div>
      <a class="btn btn-ghost rv" href="/">All articles</a>
    </div>
    <ul class="posts">
      {posts.map((p, i) => (
        <li class="post rv" style={`--d:${i * 70}ms`}>
          <a href={`/${p.data.category}/${p.id}/`}>
            <span class="mono post-cat">{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

</div>

<style is:global>
/* ================= INSTRUMENT ================= */
/* System of record: DESIGN.md. Colour is Committed: navy structures, */
/* the aurora carries mood, Oracle red is the only thing that asks you to act. */
.inst{
  --field:#FAFBFD; --surface:#fff;
  --ink:#0B1B34; --ink2:#4D5A74; --ink3:#7C879B;
  --hair:#DFE5EE;
  --act:#C74634; --act-2:#A83A2B;
  --blue:#1F5AA8; --ok:#1FA37A;
  --sora:Sora,"Oracle Sans",system-ui,sans-serif;
  --arch:Archivo,"Oracle Sans",system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
  background:var(--field); color:var(--ink2); font-family:var(--arch);
}
.inst .shell{max-width:1240px;margin:0 auto;padding:0 56px}
.inst .mono{font-family:var(--mono)}
.inst .eyebrow{font-weight:600;font-size:11px;font-family:var(--mono);line-height:1;letter-spacing:.16em;text-transform:uppercase;color:var(--act)}
.inst .eyebrow-on-dark{color:#FF8B76}
.inst h2{margin-top:16px;font-weight:700;font-size:clamp(1.65rem,3.1vw,2.5rem);font-family:var(--sora);line-height:1.14;
  letter-spacing:-.03em;color:var(--ink);max-width:22ch;text-wrap:balance}
.inst h3{font-weight:700;font-size:17.5px;font-family:var(--sora);color:var(--ink)}
.inst p{line-height:1.66}
.inst code{font-weight:500;font-size:.92em;font-family:var(--mono);background:#EEF2F8;border:1px solid var(--hair);
  border-radius:5px;padding:1px 6px;color:var(--ink)}
.inst .block{padding:clamp(72px,9vw,124px) 0}

/* ---- hero ---- */
.inst .hero-wrap{position:relative;overflow:clip;padding-bottom:24px}
.inst .aurora{position:absolute;inset:-30% -12% auto -12%;height:1120px;pointer-events:none;z-index:0}
.inst .aurora span{display:block;width:100%;height:100%;filter:blur(46px);
  background:
    radial-gradient(40% 48% at 16% 24%,rgba(31,90,168,.42),transparent 68%),
    radial-gradient(36% 42% at 76% 14%,rgba(31,163,122,.36),transparent 70%),
    radial-gradient(34% 40% at 54% 58%,rgba(199,70,52,.30),transparent 72%);
  animation:drift 28s ease-in-out infinite alternate}
@keyframes drift{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(-3%,2%,0) scale(1.08)}}
.inst .rule-grid{position:absolute;inset:0;z-index:0;pointer-events:none;
  background-image:linear-gradient(90deg,rgba(11,27,52,.045) 1px,transparent 1px);
  background-size:112px 100%;
  -webkit-mask-image:linear-gradient(180deg,#000,transparent 72%);
  mask-image:linear-gradient(180deg,#000,transparent 72%)}
.inst .hero{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) 372px;
  gap:56px;align-items:start;padding-top:clamp(44px,6vw,86px);padding-bottom:clamp(56px,7vw,96px)}
.inst h1{margin-top:20px;font-weight:800;font-size:clamp(2.35rem,5.4vw,4.3rem);font-family:var(--sora);line-height:1.03;
  letter-spacing:-.038em;color:var(--ink)}
.inst h1 .h1line{display:block;font-size:inherit;font-family:inherit;line-height:inherit}
.inst h1 .accent{color:var(--blue)}
.inst .lede{margin-top:24px;max-width:60ch;font-size:clamp(16.5px,1.25vw,18.5px);color:var(--ink2)}
.inst .actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}
.inst .btn{display:inline-block;border-radius:9px;padding:15px 27px;font-weight:600;font-size:15px;font-family:var(--arch);
  text-decoration:none;transition:transform .18s cubic-bezier(.16,1,.3,1),background-color .18s,box-shadow .18s}
.inst .btn-primary{background:var(--act);color:#fff;box-shadow:0 8px 22px rgba(199,70,52,.26)}
.inst .btn-primary:hover{background:var(--act-2);transform:translateY(-1px);box-shadow:0 12px 26px rgba(199,70,52,.32)}
.inst .btn-ghost{background:var(--surface);color:var(--ink);border:1px solid #D3DAE6}
.inst .btn-ghost:hover{transform:translateY(-1px);border-color:#B9C4D6}
.inst .btn:focus-visible{outline:2px solid var(--act);outline-offset:3px}
.inst .meta{display:flex;gap:34px;flex-wrap:wrap;margin-top:52px;padding-top:20px;border-top:1px solid var(--hair);
  font-weight:500;font-size:11.5px;font-family:var(--mono);letter-spacing:.09em;text-transform:uppercase;color:#8592a8}
.inst .meta b{display:block;font-weight:600;font-size:14.5px;font-family:var(--arch);color:var(--ink);margin-top:6px;letter-spacing:0;text-transform:none}

/* the single glass surface in the system: the product's real artifact */
.inst .artifact{background:rgba(255,255,255,.62);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border:1px solid rgba(255,255,255,.9);border-radius:16px;padding:22px;
  box-shadow:0 26px 70px rgba(11,27,52,.16)}
.inst .artifact header{display:flex;justify-content:space-between;align-items:center;
  font-weight:600;font-size:10.5px;font-family:var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink3)}
.inst .artifact .live{color:var(--ok);display:inline-flex;align-items:center;gap:6px}
.inst .artifact .live i{width:7px;height:7px;border-radius:50%;background:var(--ok);animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.82)}}
.inst .artifact h4{margin-top:14px;font-weight:700;font-size:16px;font-family:var(--sora);color:var(--ink)}
.inst .artifact dl{margin-top:6px}
.inst .artifact .row{display:flex;justify-content:space-between;gap:14px;padding:9px 0;
  border-bottom:1px solid rgba(11,27,52,.07);font-size:13.2px;color:var(--ink2)}
.inst .artifact .row:last-child{border-bottom:0}
.inst .artifact dd{font-weight:600}
.inst .artifact .ok{color:var(--ok)}
.inst .artifact .dual{margin-top:15px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.inst .artifact .dual div{border:1px solid rgba(11,27,52,.1);border-radius:8px;padding:9px 10px;
  background:rgba(255,255,255,.6)}
.inst .artifact .dual b{display:block;font-weight:600;font-size:10.5px;font-family:var(--mono);color:var(--ink)}
.inst .artifact .dual span{display:block;font-weight:400;font-size:9.5px;font-family:var(--mono);color:var(--ink3);margin-top:3px}

/* ---- split ---- */
.inst .split{margin-top:42px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:36px}
.inst .split p{margin-top:10px;color:var(--ink2);max-width:60ch}

/* ---- packs ---- */
.inst .packs{margin-top:42px;list-style:none;padding:0;border-top:1px solid var(--hair)}
.inst .pack{display:grid;grid-template-columns:58px minmax(0,1fr);gap:22px;
  padding:26px 0;border-bottom:1px solid var(--hair)}
.inst .pack-n{font-weight:600;font-size:12px;font-family:var(--mono);color:var(--ink3);padding-top:4px}
.inst .pack h3{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.inst .chip{font-weight:600;font-size:10px;font-family:var(--mono);letter-spacing:.1em;text-transform:uppercase;
  border:1px solid var(--hair);border-radius:999px;padding:3px 9px;color:var(--ink3)}
.inst .chip-free{color:var(--ok);border-color:rgba(31,163,122,.35)}
.inst .pack p{margin-top:8px;max-width:70ch;font-size:14.6px}
.inst .replaces{color:var(--ink3);font-size:14px}
.inst .replaces .mono{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--act);margin-right:6px}

/* ---- band ---- */
.inst .band{position:relative;margin-top:10px;padding:clamp(112px,12vw,152px) 0 clamp(80px,9vw,110px);
  background:linear-gradient(158deg,#0B1B34 0%,#0E2A52 54%,#0B4A6F 100%);
  clip-path:polygon(0 5%,100% 0,100% 100%,0 100%)}
.inst .band h2{color:#fff}
.inst .band-lede{margin-top:16px;max-width:62ch;color:#9FB6D4;font-size:16.5px;line-height:1.7}
.inst .plans{margin-top:44px;display:grid;grid-template-columns:repeat(auto-fit,minmax(262px,1fr));gap:18px}
.inst .plan{background:#fff;border:1px solid #E3E9F2;border-radius:13px;padding:26px;min-width:0;
  box-shadow:0 16px 40px rgba(3,12,26,.28);display:flex;flex-direction:column;gap:2px;
  transition:transform .22s cubic-bezier(.16,1,.3,1),box-shadow .22s}
.inst .plan:hover{transform:translateY(-3px);box-shadow:0 22px 52px rgba(3,12,26,.34)}
.inst .plan.is-pick{border:1.5px solid var(--act)}
.inst .plan-k{font-weight:600;font-size:10.5px;font-family:var(--mono);letter-spacing:.13em;text-transform:uppercase;color:#8592a8}
.inst .plan.is-pick .plan-k{color:var(--act)}
.inst .plan h3{margin-top:11px}
.inst .plan-price{margin-top:13px;font-weight:800;font-size:34px;font-family:var(--sora);color:var(--ink);letter-spacing:-.03em}
.inst .plan-price small{font-weight:500;font-size:13px;font-family:var(--mono);color:#8592a8;letter-spacing:0}
.inst .plan-then{margin-top:5px;font-weight:500;font-size:12.5px;font-family:var(--mono);color:#8592a8}
.inst .plan-lock{margin-top:9px;font-weight:600;font-size:11.5px;font-family:var(--mono);color:var(--ok)}
.inst .plan-blurb{margin-top:13px;font-size:14px;color:#5B6880;flex:1}
.inst .plan-cta{margin-top:18px;font-weight:600;font-size:13.5px;font-family:var(--arch);color:var(--act)}
.inst .plan-rules{margin-top:26px;padding-left:18px;display:flex;flex-direction:column;gap:7px;
  font-size:13.5px;color:#9FB6D4;max-width:74ch}
.inst .plans-note{margin-top:30px;color:#9FB6D4;font-family:var(--mono);font-size:13.5px}

/* ---- truths ---- */
.inst .truths{margin-top:42px;display:grid;grid-template-columns:repeat(auto-fit,minmax(238px,1fr));gap:30px}
.inst .truth p{margin-top:9px;font-size:14.6px}

/* ---- posts ---- */
.inst .block-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap}
.inst .posts{margin-top:38px;list-style:none;padding:0;display:grid;
  grid-template-columns:repeat(auto-fit,minmax(272px,1fr));gap:18px}
.inst .post a{display:block;height:100%;background:var(--surface);border:1px solid var(--hair);
  border-radius:13px;padding:24px;text-decoration:none;
  transition:transform .22s cubic-bezier(.16,1,.3,1),border-color .22s,box-shadow .22s}
.inst .post a:hover{transform:translateY(-3px);border-color:#C6D0E0;box-shadow:0 14px 34px rgba(11,27,52,.09)}
.inst .post-cat{font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--act)}
.inst .post h3{margin-top:11px;font-size:16.5px;line-height:1.34}
.inst .post p{margin-top:9px;font-size:14px;color:var(--ink3)}

/* ---- motion ---- */
.motion .inst .rv{opacity:0;transform:translateY(18px);
  transition:opacity .72s cubic-bezier(.16,1,.3,1) var(--d,0ms),transform .72s cubic-bezier(.16,1,.3,1) var(--d,0ms)}
.motion .inst .rv.in{opacity:1;transform:none}
.motion .inst .artifact .row{opacity:0;transform:translateY(8px)}
.motion .inst .artifact.in .row{opacity:1;transform:none;
  transition:opacity .5s ease-out calc(560ms + var(--r) * 90ms),transform .5s ease-out calc(560ms + var(--r) * 90ms)}

/* ---- responsive ---- */
@media(max-width:1080px){
  .inst .hero{grid-template-columns:minmax(0,1fr);gap:44px}
  .inst .artifact{max-width:420px}
}
@media(max-width:820px){
  .inst .shell{padding:0 24px}
  .inst .pack{grid-template-columns:minmax(0,1fr);gap:8px}
  .inst .pack-n{padding-top:0}
  .inst .meta{gap:22px 28px}
}
/* The mobile contract: motion early-returns to its final state. */
@media(prefers-reduced-motion:reduce),(max-width:767px){
  /* Must out-specify .motion .inst .rv, which carries three classes. A
     two-class override here loses and the page renders blank on a phone. */
  .motion .inst .rv,.motion .inst .artifact .row,
  .inst .rv,.inst .artifact .row{opacity:1;transform:none;transition:none}
  .inst .aurora span{animation:none}
  .inst .artifact .live i{animation:none}
  .inst .plan:hover,.inst .post a:hover,.inst .btn:hover{transform:none}
}
</style>

<script is:inline>
  (function () {
    var reduce =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      window.matchMedia('(max-width: 767px)').matches;
    var nodes = document.querySelectorAll('.inst .rv');

    /* Opt IN to motion only when we can also finish it. Without this the page
       would render blank for anyone whose JS never runs. */
    if (!reduce && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('motion');
    }

    if (reduce || !('IntersectionObserver' in window)) {
      nodes.forEach(function (n) { n.classList.add('in'); });
      document.querySelectorAll('.inst .count').forEach(function (c) {
        c.textContent = c.getAttribute('data-to');
      });
      return;
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        io.unobserve(e.target);
        var counters = e.target.querySelectorAll ? e.target.querySelectorAll('.count') : [];
        counters.forEach(function (c) { runCount(c); });
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    nodes.forEach(function (n) { io.observe(n); });

    function runCount(el) {
      var to = parseInt(el.getAttribute('data-to'), 10) || 0;
      var start = null;
      var dur = 900;
      function step(ts) {
        if (start === null) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        /* ease-out-expo so it settles rather than ticks */
        var eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
        el.textContent = String(Math.round(to * eased));
        if (p < 1) requestAnimationFrame(step);
      }
      setTimeout(function () { requestAnimationFrame(step); }, 620);
    }
  })();
</script>
</BaseLayout>
