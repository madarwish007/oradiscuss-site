# =============================================================================
# SYNTHETIC LAB CONFIG for the Showcase render of the Health Check pack.
#
# This is NOT a customer config and it is NOT shipped inside packs/. It exists
# so scripts/showcase/render-sample.sh can drive the REAL health_check.sh
# --render-only path against scripts/showcase/lab/healthcheck/collection.txt.
#
# Every identifier here is invented. ODCDEMO is a database that does not exist.
# Thresholds are the pack's shipped defaults, unchanged, so the statuses in the
# sample report are the ones the pack would actually assign.
# =============================================================================
ORACLE_SID=ODCDEMO1
ORACLE_HOME=/u01/app/oracle/product/19.0.0/dbhome_1
ORACLE_CONNECT="/ as sysdba"
LISTENER_NAME=LISTENER

# Set by render-sample.sh. Fails loudly rather than writing somewhere random.
OUTPUT_DIR="${ODC_SHOWCASE_OUT:?render-sample.sh must export ODC_SHOWCASE_OUT}"

TS_WARN_PCT=85
TS_CRIT_PCT=95
ASM_WARN_PCT=80
ASM_CRIT_PCT=90
FRA_WARN_PCT=80
FRA_CRIT_PCT=90
RMAN_FULL_MAX_AGE_HOURS=30
RMAN_ARCH_MAX_AGE_HOURS=8
INVALID_OBJ_WARN=1
RETENTION_DAYS=30
