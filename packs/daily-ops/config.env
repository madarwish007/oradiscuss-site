# ============================================================================
# OraDiscuss - Daily Operations Pack v1.0.0
# config.env - single configuration file sourced by ALL scripts in this pack.
#
# Published by OraDiscuss (oradiscuss.com). Not produced by, affiliated with,
# or endorsed by Oracle Corporation.
#
# Written for Oracle 19c/21c/23ai on Linux - FIELD-TEST BEFORE PRODUCTION USE.
# Same config style as the Health Check pack. env_collector.sh GENERATES a
# ready-made config-<node>.env per node - prefer that over editing by hand.
#
# SECURITY: this file must NEVER contain passwords. Scripts connect via
#           OS authentication ("sqlplus / as sysdba") by default.
# ============================================================================

# --- Oracle environment -----------------------------------------------------
ORACLE_SID=""
ORACLE_HOME=""
ORACLE_CONNECT="/ as sysdba"
LISTENER_NAME="LISTENER"

# --- Detected environment (informational; written by env_collector.sh) ------
DB_HOME_VERSION=""
GI_VERSION="none"
ASM_SID="none"
TOPOLOGY="standalone"
CLUSTER_NODES=""

# --- Site naming standard (tbs_manager.sh --add-datafile) --------------------
# %TS% = tablespace name (lowercase), %NN% = zero-padded sequence number.
DATAFILE_NAME_STANDARD="${ORACLE_BASE:-/u01/app/oracle}/oradata/\${ORACLE_SID}/%TS%_%NN%.dbf"

# --- Thresholds --------------------------------------------------------------
TS_WARN_PCT=80
TS_CRIT_PCT=90
RMAN_FULL_MAX_AGE_HOURS=30
RMAN_ARCH_MAX_AGE_HOURS=8
STANDBY_LAG_WARN_MIN=30
STALE_STATS_WARN=50

# --- History table (opt-in; same table as the Health Check pack uses) -------
TS_HISTORY_TABLE="ORADISCUSS_TS_HISTORY"

# --- Output / notifications ---------------------------------------------------
OUTPUT_DIR="$HOME/oradiscuss-dailyops/output"
NOTIFY_ENABLED=0
NOTIFY_EMAIL=""
