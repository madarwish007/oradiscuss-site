# ============================================================================
# OraDiscuss - RCA Generator Pack v1.0.0
# config.env - configuration for rca_generator.sh.
#
# Published by OraDiscuss (oradiscuss.com). Not produced by, affiliated with,
# or endorsed by Oracle Corporation.
#
# Written for Oracle 19c/21c/23ai on Linux. Same config style as the other
# packs, so if you already run one of those you can copy your values across.
#
# SECURITY: this file must NEVER contain passwords. Scripts connect via
#           OS authentication ("sqlplus / as sysdba") by default.
# ============================================================================

# --- Oracle environment -----------------------------------------------------
# SID of the instance to analyse. There is no default, on purpose.
ORACLE_SID=""
ORACLE_HOME=""
# For a non-SYS monitoring user use a wallet TNS alias. Never a password here.
ORACLE_CONNECT="/ as sysdba"
# Used to resolve the listener log path under ADR.
LISTENER_NAME="LISTENER"

# --- Collection limits ------------------------------------------------------
# Upper bound on events pulled from any single source. An incident can produce
# tens of thousands of alert log lines, and a timeline nobody can read is not
# better than a truncated one that says it was truncated.
RCA_MAX_EVENTS=500

# Two events are treated as candidates for an ordering correlation only when
# they fall within this many seconds of each other. Widen it and unrelated
# events start looking connected, which is the failure mode that matters here:
# a false correlation during an incident sends somebody down the wrong path at
# the worst possible moment.
RCA_CORRELATION_WINDOW_SEC=600

# --- Output -----------------------------------------------------------------
OUTPUT_DIR="$HOME/oradiscuss-rca/output"
