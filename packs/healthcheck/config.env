# ============================================================================
# OraDiscuss - DBA Health Check Automation Pack v1.0.0
# config.env - single configuration file sourced by ALL scripts in this pack.
#
# Written for Oracle 19c/21c.
#
# Generated and published by OraDiscuss (oradiscuss.com). Not produced by,
# affiliated with, or endorsed by Oracle Corporation.
# READ-ONLY: this pack issues no DDL and no DML against your data.
#
# Review it before you run it, and run it somewhere that is not production
# first. You are the DBA.
#
# License: single-user license. You may modify for your own use.
#          No redistribution (resale, reposting, bundling) permitted.
#
# SECURITY: this file must NEVER contain passwords. Scripts connect via
#           OS authentication ("sqlplus / as sysdba") by default. Run as the
#           oracle OS user (or a user in the dba OS group). Scripts will never
#           print connection details.
# ============================================================================

# --- Oracle environment -----------------------------------------------------
# SID of the instance to check (no default - you MUST set this).
ORACLE_SID=""

# Oracle home, e.g. /u01/app/oracle/product/19.0.0/dbhome_1
ORACLE_HOME=""

# Connect string used for sqlplus. Default is OS authentication.
# If you must use a password account, set ORACLE_CONNECT to a TNS alias and
# use a secure external password store (wallet). NEVER put user/pass here.
ORACLE_CONNECT="/ as sysdba"

# --- Thresholds --------------------------------------------------------------
# Tablespace usage percent: WARN at/above, CRIT at/above.
TS_WARN_PCT=80
TS_CRIT_PCT=90

# FRA / DB_RECOVERY_FILE_DEST usage percent thresholds.
FRA_WARN_PCT=80
FRA_CRIT_PCT=90

# ASM diskgroup usage percent thresholds (skipped automatically if no ASM).
ASM_WARN_PCT=80
ASM_CRIT_PCT=90

# RMAN backup recency: CRIT if no successful backup of a given type in this
# many hours. (0 = skip the recency check for that type.)
RMAN_FULL_MAX_AGE_HOURS=30
RMAN_ARCH_MAX_AGE_HOURS=8

# Invalid objects: WARN at/above this count (0 = any invalid object warns).
INVALID_OBJ_WARN=1

# --- Output / retention -------------------------------------------------------
# Base directory for reports and CSV logs. Created if missing.
OUTPUT_DIR="$HOME/oradiscuss-healthcheck/output"

# orchestrate.sh prunes run directories older than this many days.
RETENTION_DAYS=30

# --- Email (optional, OFF by default) -----------------------------------------
# Set EMAIL_ENABLED=1 to have orchestrate.sh mail the HTML report using the
# local `mail` or `sendmail` binary. Nothing is sent unless enabled here.
EMAIL_ENABLED=0
EMAIL_TO=""
EMAIL_SUBJECT_PREFIX="[OraDiscuss HealthCheck]"

# --- History table (opt-in, see docs) -----------------------------------------
# tablespace_monitor.sh can project growth if a retained history table exists.
# Creation of that table is a SEPARATE, OPT-IN step: run
#   sql/create_history_table.sql   (review it first - it is the ONLY script
#   in this pack that writes to the database).
# Leave this as-is unless you have created the table.
TS_HISTORY_TABLE="ORADISCUSS_TS_HISTORY"
